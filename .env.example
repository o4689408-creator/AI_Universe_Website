# Copy to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.

# The production URL of the site. Used for canonical URLs, sitemap,
# and Open Graph metadata. Vercel preview deployments can leave this
# unset (falls back to the production domain in lib/config.ts) or set
# it to the preview URL for accurate preview metadata.
NEXT_PUBLIC_SITE_URL=https://aiuniverse.com

# Optional. Set to your Plausible domain to enable analytics
# (components/analytics/Analytics.tsx). Leave unset to load no
# analytics script at all.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# REQUIRED for the newsletter form (sections/NewsletterSection.tsx,
# components/contact/FooterNewsletterForm.tsx) to actually store
# subscribers. This is Vercel KV — a Redis database that's a
# first-party Vercel add-on, not a separate account:
#   Vercel dashboard -> your project -> Storage tab -> Create Database
#   -> KV -> Connect to this project.
# Vercel then injects these two automatically; you don't type them in
# yourself, and you don't need them for local dev unless you want to
# test signup locally (in which case copy them from the Vercel
# dashboard's ".env.local" tab for the KV database).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# OPTIONAL — layered on top of KV. If set, a confirmation email is
# sent on signup, and (if RESEND_AUDIENCE_ID is also set) the
# subscriber is mirrored into that Resend Audience so
# scripts/notify-from-git-diff.mjs / notify-subscribers.mjs can email
# them later. Get RESEND_API_KEY from https://resend.com/api-keys and
# create an Audience at https://resend.com/audiences for
# RESEND_AUDIENCE_ID. None of this blocks signup from working — see
# app/api/newsletter/route.ts.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Required for the contact form (components/contact/ContactForm.tsx)
# to actually deliver messages via email — uses the same
# RESEND_API_KEY above. RESEND_FROM must be a sender Resend will
# accept — either a verified domain sender
# ("AI Universe <hello@yourdomain.com>") or, for testing before you
# verify a domain, "AI Universe <onboarding@resend.dev>". If this
# isn't set, the contact form automatically falls back to opening the
# visitor's own email app instead — see components/contact/ContactForm.tsx.
RESEND_FROM=

# Optional. Only needed if you want a premium multi-language dictionary
# lookup (app/api/dictionary/route.ts) beyond the built-in free
# provider (dictionaryapi.dev, no key required, English-focused). If
# set, the route prefers this provider. Any WordsAPI-compatible key
# from https://rapidapi.com/dpventures/api/wordsapi works.
WORDS_API_KEY=
