# Copy to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.

# The production URL of the site. Used for canonical URLs, sitemap,
# and Open Graph metadata. Vercel preview deployments can leave this
# unset (falls back to the production domain in lib/config.ts) or set
# it to the preview URL for accurate preview metadata.
NEXT_PUBLIC_SITE_URL=https://aiuniverse.com

# Optional. Set to your Plausible domain to enable analytics
# (components/analytics/Analytics.tsx). Leave unset to load no
# analytics script at all.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Required for the newsletter form (sections/NewsletterSection.tsx,
# components/contact/FooterNewsletterForm.tsx) to actually add
# subscribers. Get RESEND_API_KEY from https://resend.com/api-keys and
# create an Audience at https://resend.com/audiences to get
# RESEND_AUDIENCE_ID. Until both are set, the newsletter form will
# show a clear "not configured yet" error instead of silently failing.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Required for the contact form (components/contact/ContactForm.tsx)
# to actually deliver messages. Uses the same RESEND_API_KEY above.
# RESEND_FROM must be a sender Resend will accept — either a verified
# domain sender ("AI Universe <hello@yourdomain.com>") or, for testing
# before you verify a domain, "AI Universe <onboarding@resend.dev>".
RESEND_FROM=

# Optional. Only needed if you want a premium multi-language dictionary
# lookup (app/api/dictionary/route.ts) beyond the built-in free
# provider (dictionaryapi.dev, no key required, English-focused). If
# set, the route prefers this provider. Any WordsAPI-compatible key
# from https://rapidapi.com/dpventures/api/wordsapi works.
WORDS_API_KEY=
