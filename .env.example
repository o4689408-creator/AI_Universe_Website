# Copy to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.

# The production URL of the site. Used for canonical URLs, sitemap,
# and Open Graph metadata. Vercel preview deployments can leave this
# unset (falls back to the production domain in lib/config.ts) or set
# it to the preview URL for accurate preview metadata.
NEXT_PUBLIC_SITE_URL=https://aiuniverse.com

# Optional. Set to your Plausible domain to enable analytics
# (components/analytics/Analytics.tsx). Leave unset to load no
# analytics script at all.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# REQUIRED for the newsletter form (sections/NewsletterSection.tsx,
# components/contact/FooterNewsletterForm.tsx) and the contact form
# (components/contact/ContactForm.tsx) to actually store data.
# This is MongoDB Atlas, connected via the Vercel <-> MongoDB Atlas
# integration (Vercel project -> Storage/Integrations -> MongoDB
# Atlas -> connect a cluster to this project). Once connected, Vercel
# injects MONGODB_URI automatically — for local dev, copy the
# connection string from your Atlas cluster ("Connect" -> "Drivers")
# into .env.local yourself.
MONGODB_URI=
# Optional — database name to use. Defaults to "ai_universe" if unset.
MONGODB_DB=

# OPTIONAL — layered on top of MongoDB. If set, a confirmation email
# is sent on newsletter signup, and (if RESEND_AUDIENCE_ID is also
# set) the subscriber is mirrored into that Resend Audience so
# scripts/notify-from-git-diff.mjs / notify-subscribers.mjs can email
# them later. Get RESEND_API_KEY from https://resend.com/api-keys and
# create an Audience at https://resend.com/audiences for
# RESEND_AUDIENCE_ID. None of this blocks signup from working — see
# app/api/newsletter/route.ts.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# OPTIONAL — layered on top of MongoDB for the contact form. If set,
# every submission is also emailed to you immediately via Resend
# (uses the same RESEND_API_KEY above), in addition to always being
# saved in MongoDB's contact_submissions collection. RESEND_FROM must
# be a sender Resend will accept — either a verified domain sender
# ("AI Universe <hello@yourdomain.com>") or, for testing before you
# verify a domain, "AI Universe <onboarding@resend.dev>". If MONGODB_URI
# itself isn't set, the contact form automatically falls back to
# opening the visitor's own email app instead — see
# components/contact/ContactForm.tsx.
RESEND_FROM=

# Optional. Only needed if you want a premium multi-language dictionary
# lookup (app/api/dictionary/route.ts) beyond the built-in free
# provider (dictionaryapi.dev, no key required, English-focused). If
# set, the route prefers this provider. Any WordsAPI-compatible key
# from https://rapidapi.com/dpventures/api/wordsapi works.
WORDS_API_KEY=
